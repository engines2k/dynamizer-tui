#ascii-art {
	width: 100%;
	content-align: center middle;
}

VisualizerDisplay {
	padding: 1;
	border: dashed $boost;
}

WLEDOptions {
   layout: horizontal;
   height: auto;
}

CoreOptions {
	height: auto;
	background: $boost;
	align: center middle;
	padding: 1;
}

CoreOptions #status {
	text-align: center;
}

CoreOptionsControls {   
    margin: 1;
    min-width: 50;
    padding: 1;
}

CoreOptionsControls ProgressBar {
	border: wide $boost;
	height: 3;
	margin-top: 1;
}

Switch {
	padding: 0 1;
	height: 3;
}

Button {
    width: 16;
}
